{
  "manifest_version": 3,
  "name": "PDF Library",
  "version": "1.0.0",
  "description": "A local PDF library manager and reader.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon16.png"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["index.html", "pdf.worker.min.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
