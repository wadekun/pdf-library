{
  "manifest_version": 3,
  "name": "PDF Library",
  "version": "1.0.0",
  "description": "一个本地 PDF 图书管理器和阅读器。",
  "permissions": [
    "storage",
    "tabs",
    "fileSystem"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["index.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
